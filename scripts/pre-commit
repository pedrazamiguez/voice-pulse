#!/usr/bin/env bash
set -euo pipefail

# ANSI color codes
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Filter staged files for .java changes
STAGED_JAVA_FILES=$(git diff --cached --name-only | grep '\.java$' || true)

if [ -z "$STAGED_JAVA_FILES" ]; then
    # Non-Java staged files skip Java checks immediately (fast-exit 0)
    exit 0
fi

# 1. Enforce 600-line architectural ceiling on staged production Java files
VIOLATIONS=""
while IFS= read -r file; do
    [ -z "$file" ] && continue
    # Exclude test files from 600-line limit
    case "$file" in
        */test/*|*/src/test/*)
            continue
            ;;
        *)
            if [ -f "$file" ]; then
                LINES=$(wc -l < "$file" | tr -d ' ')
                if [ "$LINES" -gt 600 ]; then
                    VIOLATIONS="${VIOLATIONS}  • $file: $LINES lines (ceiling: 600)\n"
                fi
            fi
            ;;
    esac
done <<< "$STAGED_JAVA_FILES"

if [ -n "$VIOLATIONS" ]; then
    printf "\n${RED}❌ Commit rejected: Production Java file exceeds 600-line architectural ceiling (AGENTS.md):${NC}\n"
    printf "${RED}${VIOLATIONS}${NC}\n"
    printf "${YELLOW}💡 Extract cohesive collaborators (strategy classes, validators, delegates) before committing.${NC}\n\n"
    exit 1
fi

# 2. Run fast quality gate (Spotless formatting check + ArchUnit rules)
if [ ! -x "./mvnw" ]; then
    printf "\n${RED}❌ Commit rejected: Maven Wrapper './mvnw' not found or not executable.${NC}\n"
    printf "${YELLOW}💡 Run 'chmod +x ./mvnw' or provision the wrapper.${NC}\n\n"
    exit 1
fi

printf "\n${CYAN}🔍 [pre-commit] Validating staged Java changes with 'make fast-check'...${NC}\n"

if ! make fast-check; then
    printf "\n${RED}❌ Commit rejected: 'make fast-check' failed.${NC}\n"
    printf "${YELLOW}💡 Remediation options:${NC}\n"
    printf "   • Run ${CYAN}make format${NC} to automatically apply Spotless formatting.\n"
    printf "   • Run ${CYAN}make arch-check${NC} to inspect ArchUnit rule failures or line limit issues.\n\n"
    exit 1
fi

printf "${GREEN}✅ [pre-commit] All quality gates passed.${NC}\n\n"
exit 0
