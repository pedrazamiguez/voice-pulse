#!/usr/bin/env bash
set -euo pipefail

# ANSI color codes
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

remote="${1:-origin}"
url="${2:-}"

# Read ref updates from stdin: <local ref> <local oid> <remote ref> <remote oid>
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        "refs/heads/develop"|"refs/heads/main")
            printf "\n${RED}❌ Push rejected: Direct push to protected base branch '%s' is prohibited.${NC}\n" "${remote_ref#refs/heads/}"
            printf "${YELLOW}💡 Specification-Driven Development (SDD) Mandate (AGENTS.md):${NC}\n"
            printf "   All work must be conducted on a dedicated feature, fix, or internal branch.\n"
            printf "   Please push your branch and open a Pull Request to merge into develop.\n\n"
            exit 1
            ;;
    esac
done

current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
if [ "$current_branch" = "develop" ] || [ "$current_branch" = "main" ]; then
    printf "\n${RED}❌ Push rejected: Direct push while checked out on '%s' is prohibited.${NC}\n" "$current_branch"
    printf "${YELLOW}💡 Switch to a dedicated feature, fix, or internal branch before pushing.${NC}\n\n"
    exit 1
fi

exit 0
